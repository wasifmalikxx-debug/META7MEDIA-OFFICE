generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  PARTNER // multi-office partner: scoped admin for assigned teams within one office
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  HIRED
  PROBATION
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
  EMERGENCY
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum IncentiveType {
  FIXED
  PERCENTAGE
  TARGET_BASED
  MANUAL
}

enum FineType {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  ABSENT_WITHOUT_LEAVE
  POLICY_VIOLATION
  OTHER
}

enum WarningLevel {
  VERBAL
  FIRST_WRITTEN
  SECOND_WRITTEN
  FINAL
  TERMINATION
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  DISPUTED
}

enum NotificationType {
  LEAVE_REQUEST
  LEAVE_APPROVED
  LEAVE_REJECTED
  FINE_ISSUED
  INCENTIVE_AWARDED
  PAYROLL_GENERATED
  ANNOUNCEMENT
  WARNING_ISSUED
  GENERAL
  REVIEW_BONUS_SUBMITTED
  REVIEW_BONUS_APPROVED
  REVIEW_BONUS_REJECTED
  BONUS_ELIGIBILITY_UPDATED
  COMPLAINT_SUBMITTED
  COMPLAINT_RESPONDED
  COMPLAINT_STATUS_CHANGED
}

enum ComplaintCategory {
  BUG
  PAYROLL
  ATTENDANCE
  HR
  POLICY
  TECHNICAL
  HARASSMENT
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  APPROVED
  RESOLVED
  DENIED
}

enum ReviewBonusStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

// ─── Models ──────────────────────────────────────────

// Multi-office support. Each Office is a physical location with its own
// settings, holidays, departments, and partner-scoped teams. OFFICE 1 is
// the original (pre-multi-office) location, isPrimary=true. OFFICE 2+ are
// branches managed by partners. CEO (SUPER_ADMIN) has god-mode across all.
model Office {
  id        String  @id @default(cuid())
  slug      String  @unique // "office-1", "office-2"
  name      String // "META7MEDIA HQ", "Lahore Branch"
  isPrimary Boolean @default(false) // exactly one true; OFFICE 1 = true
  ownerId   String? // CEO for OFFICE 1, optional for branches
  owner     User?   @relation("OfficeOwner", fields: [ownerId], references: [id])

  users            User[]            @relation("OfficeUsers")
  departments      Department[]
  settings         OfficeSettings?
  holidays         Holiday[]
  payrollSnapshots PayrollSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String         @id @default(cuid())
  employeeId   String         @unique // e.g. "M7M-001"
  email        String         @unique
  password     String // bcrypt hashed
  firstName    String
  lastName     String
  phone        String?
  phone2       String?
  profilePhoto String?
  role         Role           @default(EMPLOYEE)
  status       EmployeeStatus @default(HIRED)
  joiningDate  DateTime
  resignDate   DateTime?
  designation  String?

  // Bank account details
  bankName      String?
  accountNumber String?
  accountTitle  String?

  // Google Sheet URL for profit tracking
  googleSheetUrl String?

  // Office assignment. Backfilled in Phase 2; made NOT NULL in Phase 3.
  officeId         String
  office           Office            @relation("OfficeUsers", fields: [officeId], references: [id])
  ownedOffices     Office[]          @relation("OfficeOwner")
  partnerTeams     Team[]            @relation("TeamPartner")
  auditLogs        AuditLog[]
  teamPayrollMarks TeamPayrollMark[]

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  teamId       String?
  team         Team?       @relation(fields: [teamId], references: [id])
  managerId    String?
  manager      User?       @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]      @relation("ManagerSubordinates")

  attendances            Attendance[]
  leaveRequests          LeaveRequest[]     @relation("LeaveRequester")
  leaveApprovals         LeaveRequest[]     @relation("LeaveApprover")
  salaryStructure        SalaryStructure?
  payrollRecords         PayrollRecord[]
  incentivesReceived     Incentive[]        @relation("IncentiveRecipient")
  incentivesGiven        Incentive[]        @relation("IncentiveGiver")
  finesReceived          Fine[]             @relation("FineRecipient")
  finesIssuedBy          Fine[]             @relation("FineIssuer")
  warningsReceived       Warning[]          @relation("WarningRecipient")
  warningsIssuedBy       Warning[]          @relation("WarningIssuer")
  notifications          Notification[]
  announcements          Announcement[]
  leaveBalances          LeaveBalance[]
  deviceApprovals        DeviceApproval[]
  bonusEligibilities     BonusEligibility[] @relation("BonusEmployee")
  bonusUpdatedBy         BonusEligibility[] @relation("BonusUpdater")
  reviewBonusesSubmitted ReviewBonus[]      @relation("ReviewBonusSubmitter")
  reviewBonusesApproved  ReviewBonus[]      @relation("ReviewBonusApprover")
  dailyReports           DailyReport[]
  seoAutopilotUsage      SeoAutopilotUsage[] @relation("SeoAutopilotUsageUser")
  seoAutopilotLogs       SeoAutopilotLog[]   @relation("SeoAutopilotLogUser")
  seoAutopilotTagSwaps   SeoAutopilotTagSwapLog[] @relation("SeoAutopilotTagSwapUser")
  aliExpressTokens       AliExpressToken[]   @relation("AliExpressTokenUser")
  employeeNiches         EmployeeNiche[]     @relation("EmployeeNicheUser")
  trendingClaims         DailyTrendingProduct[] @relation("TrendingClaimedBy")
  complaintsSubmitted    Complaint[]        @relation("ComplaintSubmitter")
  complaintsResolved     Complaint[]        @relation("ComplaintResponder")
  complaintMessages      ComplaintMessage[] @relation("ComplaintMessageSender")
  refundsSubmitted       Refund[]           @relation("RefundSubmitter")
  payrollSnapshotsLocked PayrollSnapshot[]  @relation("PayrollSnapshotLocker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@index([officeId])
}

model Department {
  id     String  @id @default(cuid())
  name   String // No longer globally unique; uniqueness is per-office (see @@unique below)
  headId String?
  teams  Team[]
  users  User[]

  // Office scoping. Backfilled Phase 2, made NOT NULL Phase 3. The composite
  // unique allows OFFICE 2 to have its own "Etsy" / "Facebook" department.
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, officeId])
  @@index([officeId])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leadId       String?
  members      User[]

  // Multi-office partner ownership. Set when a partner manages this team.
  // OFFICE 1 (CEO-managed) teams stay NULL — falls back to leadId where used.
  partnerId String?
  partner   User?   @relation("TeamPartner", fields: [partnerId], references: [id])

  // Per-team Google Sheet for profit / bonus tracking. Each Etsy team has
  // its own sheet (Wasif's = EM-, Awais's = AE-, Mubeen's = ME-).
  googleSheetId String?

  // Bonus rate paid to the team-lead/partner per eligible employee per month.
  // OFFICE 1 default 5000 (matches existing Izaan formula). NULL = no team-lead bonus
  // (used for partner-led teams where the partner isn't an employee).
  leadBonusPerEligible Float?

  payrollMarks TeamPayrollMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([partnerId])
}

// Per-team payroll close state. Each partner closes their own team's
// monthly payroll independently. The office-level snapshot is the
// aggregate of all team marks for that office/month.
model TeamPayrollMark {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  month      Int
  year       Int
  status     String // "READY" | "PAID"
  markedById String
  markedBy   User      @relation(fields: [markedById], references: [id])
  paidAt     DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, month, year])
  @@index([month, year])
}

// Forensic audit trail for partner-scoped writes. Used to spot-check
// that authorization scoping is working and to give Wasif a "what did
// each partner do this week" view. Cheap to insert, never updated.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // "PAYROLL_LOCK", "FINE_ISSUE", "USER_DELETE", etc.
  targetId  String?
  officeId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([officeId, createdAt])
}

model Attendance {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id])
  date   DateTime         @db.Date
  status AttendanceStatus @default(ABSENT)

  checkIn  DateTime?
  checkOut DateTime?

  checkInIp     String?
  checkOutIp    String?
  checkInLat    Float?
  checkInLng    Float?
  checkOutLat   Float?
  checkOutLng   Float?
  checkInSelfie String?

  workedMinutes   Int?
  lateMinutes     Int?
  earlyLeaveMin   Int?
  overtimeMinutes Int?

  // Break tracking
  breakStart   DateTime?
  breakEnd     DateTime?
  breakMinutes Int?

  informedAbsent Boolean @default(false) // employee informed about absence

  notes         String?
  isManualEntry Boolean @default(false)
  approvedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveRequester", fields: [userId], references: [id])
  leaveType     LeaveType
  halfDayPeriod String? // "FIRST_HALF" or "SECOND_HALF" — only for HALF_DAY leave type
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  totalDays     Float // supports 0.5 for half-day
  reason        String
  status        LeaveStatus @default(PENDING)

  approverId      String?
  approver        User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
  @@index([status])
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  year        Int
  casualTotal Int    @default(12)
  casualUsed  Float  @default(0)
  sickTotal   Int    @default(10)
  sickUsed    Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model SalaryStructure {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])
  monthlySalary Float
  currency      String @default("PKR")

  taxPercent      Float   @default(0)
  socialSecurity  Float   @default(0)
  otherDeductions Float   @default(0)
  deductionNotes  String?

  effectiveFrom DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  month  Int
  year   Int

  monthlySalary   Float
  workingDays     Int
  presentDays     Float
  paidLeaveDays   Float
  unpaidLeaveDays Float
  lateDays        Int
  absentDays      Int
  halfDays        Float @default(0)

  dailyRate    Float
  earnedSalary Float

  totalIncentives Float         @default(0)
  totalFines      Float         @default(0)
  totalDeductions Float         @default(0)
  netSalary       Float
  status          PayrollStatus @default(DRAFT)

  paidAt       DateTime?
  paymentProof String?
  notes        String?
  generatedBy  String?

  // Lock: when set, the record is immutable — no auto-regen, no status
  // changes via the normal PATCH endpoint, no recalculation on view.
  // Unlocking clears this field. Independent from PAID status.
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([status])
}

// Immutable monthly payroll snapshot. Created when an admin locks a month's
// payroll. Stores the full state of every payroll record plus totals so the
// audit trail survives even if records are later edited or the employee row
// is deleted. One snapshot per (month, year).
model PayrollSnapshot {
  id         String   @id @default(cuid())
  month      Int
  year       Int
  lockedAt   DateTime @default(now())
  lockedById String
  lockedBy   User     @relation("PayrollSnapshotLocker", fields: [lockedById], references: [id])

  // Multi-office: each office locks its month independently. Backfilled in
  // Phase 2; required from Phase 3. The composite unique allows OFFICE 1 and
  // OFFICE 2 to lock the same month independently.
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  recordCount     Int
  totalGross      Float
  totalIncentives Float
  totalFines      Float
  totalNet        Float

  // Full payroll rows at time of lock. Stored as JSON so we never lose the
  // exact values the CEO approved, even if the underlying record changes.
  data Json

  createdAt DateTime @default(now())

  @@unique([month, year, officeId])
  @@index([year, month])
  @@index([officeId])
}

model Incentive {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("IncentiveRecipient", fields: [userId], references: [id])
  type       IncentiveType
  amount     Float
  percentage Float?
  reason     String
  month      Int
  year       Int

  givenById String
  givenBy   User   @relation("IncentiveGiver", fields: [givenById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, month, year])
}

model Fine {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("FineRecipient", fields: [userId], references: [id])
  type   FineType
  amount Float
  reason String
  date   DateTime @db.Date
  month  Int
  year   Int

  issuedById String
  issuedBy   User   @relation("FineIssuer", fields: [issuedById], references: [id])

  linkedAttendanceId String?
  linkedWarningId    String?

  createdAt DateTime @default(now())

  @@index([userId, month, year])
  @@index([date])
}

model Warning {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation("WarningRecipient", fields: [userId], references: [id])
  level   WarningLevel
  reason  String
  details String?
  date    DateTime     @db.Date

  issuedById String
  issuedBy   User   @relation("WarningIssuer", fields: [issuedById], references: [id])

  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([level])
}

model Announcement {
  id       String @id @default(cuid())
  title    String
  content  String
  priority Int    @default(0) // 0=normal, 1=important, 2=urgent

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)
  linkUrl String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model OfficeSettings {
  // ID is cuid for new offices; the legacy OFFICE 1 row keeps id="default" so
  // any straggler `findUnique({where:{id:"default"}})` lookup still works
  // during the transition.
  id         String @id @default(cuid())
  officeName String @default("META7MEDIA")

  // One settings row per office. Backfilled in Phase 2; required from Phase 3.
  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])

  workStartTime       String @default("11:00") // HH:mm
  workEndTime         String @default("19:00")
  graceMinutes        Int    @default(10)
  halfDayThresholdMin Int    @default(240) // <4hrs worked = half day

  lateFineTier1Min Int   @default(10)
  lateFineTier1Amt Float @default(0)
  lateFineTier2Min Int   @default(30)
  lateFineTier2Amt Float @default(0)
  lateFineTier3Min Int   @default(60)
  lateFineTier3Amt Float @default(0)

  autoAbsentAfterMin Int @default(240) // no check-in after 4hrs

  paidLeavesPerMonth Int @default(1) // auto-applied to first absence each month

  allowedIps           String  @default("")
  ipRestrictionEnabled Boolean @default(false)

  officeLat       Float?
  officeLng       Float?
  geoFenceRadiusM Int     @default(200)
  geoFenceEnabled Boolean @default(false)

  selfieRequired Boolean @default(false)

  // Break timings
  breakStartTime       String @default("15:00") // HH:mm (3:00 PM PKT)
  breakEndTime         String @default("16:00") // (4:00 PM PKT)
  breakDurationMin     Int    @default(60)
  breakGraceMinutes    Int    @default(5) // grace after break end
  breakLateFineAmt     Float  @default(100) // fine for returning late from break OR skipping break (PKR 100)
  fridayBreakStartTime String @default("13:30") // Friday Jummah+break start (1:30 PM)
  fridayBreakEndTime   String @default("14:45") // Friday Jummah+break end (2:45 PM)
  noReportFineAmt      Float  @default(100) // fine for not submitting daily report at auto-checkout

  workingDaysPerWeek Int    @default(6) // Mon-Sat
  weekendDays        String @default("0") // 0=Sunday

  // WhatsApp notifications
  whatsappEnabled Boolean @default(true)
  adminPhone      String? // CEO phone for admin alerts (with country code e.g. +923208888445)

  updatedAt DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  name String
  date DateTime @db.Date
  year Int

  // Optional office scope. NULL = global (applies to all offices).
  // Set to a specific officeId when a holiday is local to one branch.
  // Note: removed the legacy `@unique` on `date` — same date can now exist
  // once globally + once per office. Uniqueness is enforced via the composite
  // index below.
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([date, officeId])
  @@index([year])
  @@index([officeId])
}

enum DeviceStatus {
  PENDING
  APPROVED
  REJECTED
}

model DeviceApproval {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  fingerprint String // browser fingerprint hash
  deviceName  String? // e.g. "Chrome on Windows", "Safari on iPhone"
  ipAddress   String?
  status      DeviceStatus @default(PENDING)
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([status])
  @@index([userId])
}

// ─── Bonus Program ──────────────────────────────────

model BonusEligibility {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("BonusEmployee", fields: [userId], references: [id])
  month  Int
  year   Int

  // 7 Eligibility Criteria
  dailyListingsComplete  Boolean @default(false) // 1. Daily 5 listings
  ordersProcessedSameDay Boolean @default(false) // 2. All orders processed daily
  messagesCleared        Boolean @default(false) // 3. All messages cleared daily
  zeroWrongOrders        Boolean @default(false) // 4. Zero wrong orders
  listingsRemovedCount   Int     @default(0) // 5. Max 3 allowed
  allStoresAbove4Stars   Boolean @default(false) // 6. All stores >= 4 stars
  totalProfit            Float   @default(0) // 7. Monthly profit in USD

  // Computed
  isEligible  Boolean @default(false)
  bonusAmount Float   @default(0) // Calculated bonus in PKR
  notes       String?

  updatedById String?
  updatedBy   User?   @relation("BonusUpdater", fields: [updatedById], references: [id])

  // Multi-office: who finalized this bonus row. Used by partners to mark
  // their team's bonuses as approved before payroll lock. NULL = pending.
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([month, year])
}

model ReviewBonus {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ReviewBonusSubmitter", fields: [userId], references: [id])
  month  Int
  year   Int

  storeName        String
  customerName     String?
  originalRating   Int // 1-3
  newRating        Int // 4-5
  beforeScreenshot String // file path
  afterScreenshot  String // file path
  amount           Float   @default(500) // Rs. 500 per review

  status          ReviewBonusStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?             @relation("ReviewBonusApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, month, year])
  @@index([status])
}

// ─── Automated Messages ────────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  type      String   @unique // e.g., "LATE_FINE_10", "BREAK_FINE", "ABSENT", "SALARY_PAID"
  title     String
  template  String // message with {name}, {amount}, {minutes}, {month} placeholders
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model CustomMessage {
  id      String   @id @default(cuid())
  message String
  sentTo  String // "ALL" or employee ID
  sentBy  String
  sentAt  DateTime @default(now())
}

model DailyReport {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime @db.Date

  // Etsy fields (EM- employees)
  listingsCount Int?
  storeName     String?
  listingLinks  String? // newline-separated links

  // FB fields (SMM- employees)
  postsCount Int?
  pageNames  String?

  // Common
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

// ─── Complaints System ──────────────────────────────

model Complaint {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("ComplaintSubmitter", fields: [userId], references: [id])
  subject     String
  description String
  category    ComplaintCategory
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ComplaintResponder", fields: [resolvedById], references: [id])

  // Unread counters for quick lookups
  unreadByCeo      Boolean @default(true) // new message from employee
  unreadByEmployee Boolean @default(false) // new message from CEO

  messages ComplaintMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("ComplaintMessageSender", fields: [senderId], references: [id])
  senderRole  String // "EMPLOYEE" or "CEO"
  message     String
  imageUrl    String? // optional attached screenshot (base64 data URL)
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

// ─── Refund Tracking (Etsy team) ───────────────────

model Refund {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RefundSubmitter", fields: [userId], references: [id])

  storeName          String
  customerName       String
  etsyRefundAmount   Float // USD refunded on Etsy order
  aliexpressRefunded Boolean @default(false)
  aliexpressAmount   Float? // USD recovered from AliExpress (only if refunded)
  aliexpressProofUrl String? // screenshot proof (base64 data URL) — required when aliexpressRefunded

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Dashboard Daily Snapshots (Etsy + FB business metrics) ─────────
//
// Pre-computed per-team, per-day rollups so the CEO dashboard can render
// instantly without fetching live Google Sheets data (each cold sheet
// read takes 30-60s). Populated by the daily-report cron at 9am PKT.
//
// One row per (team, date) — for the 5 known teams (em, ae, me, fb-hq,
// fb-o2) that's ~5 rows/day = ~150 rows/month. Backfill goes 1 month
// per Wasif's preference; older history can be added later.
//
// Refund metrics are NOT stored here — they're read directly from the
// Refund table which is already DB-native and fast. This table is only
// for the slow-to-fetch sheet-derived metrics.

model DailyTeamSnapshot {
  id      String   @id @default(cuid())
  date    DateTime @db.Date // YYYY-MM-DD, no time component
  teamKey String // "em" | "ae" | "me" | "fb-hq" | "fb-o2"

  // Optional human-readable labels carried alongside the metrics so the
  // dashboard doesn't need to join back to Department/Office for display.
  // teamName e.g. "Awais Team", departmentName e.g. "Etsy - AE",
  // officeSlug e.g. "office-1".
  teamName       String?
  departmentName String?
  officeSlug     String?

  // Business metrics derived from the team's combined member sheets.
  // grossProfit is canonical = totalSale - totalCost (NOT the sheet's
  // misleading PROFIT column which is afterTax-cost).
  orders      Int   @default(0)
  totalSale   Float @default(0) // USD
  totalCost   Float @default(0) // USD (Ali Express cost)
  grossProfit Float @default(0) // USD (totalSale - totalCost)

  // Optional carry-over of the sheet's after-tax column, for diagnostics
  // and any future surface that needs it. Not used in the main dashboard.
  afterTax Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One snapshot per team per day. Re-running the cron upserts.
  @@unique([date, teamKey])
  @@index([date])
  @@index([teamKey, date])
}

// ─── SEO Autopilot daily-usage quota ─────────────────────────────────
//
// One row per (user, calendar day). `date` is anchored to Pakistan time
// (UTC+5) — we compute YYYY-MM-DD in Asia/Karachi and store at midnight
// UTC. Reset is at PKT midnight.
//
// Hard limit: 8 generations per day per user. SUPER_ADMIN bypasses the
// cap entirely. The /api/seo-autopilot/generate route increments `count`
// atomically (upsert) before doing the expensive Sonnet call; if the
// pre-increment count is >= cap it returns 429 with no work done.
//
// Used by:
//   - the autopilot UI to show "X / 8 today" badge
//   - the CEO usage panel showing per-user counts today (catch misuse)
model SeoAutopilotUsage {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("SeoAutopilotUsageUser", fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  count  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

// Per-generation audit log for the CEO dashboard. Every completed
// generation (ALLOWED, REVIEW, or BLOCKED) writes one row here so the
// CEO can see WHO generated WHAT and WHEN — which catches misuse
// (spam titles, off-brand experiments, IP attempts) that the daily
// counter alone can't surface.
//
// Failed generations (Sonnet errors, Etsy errors, etc.) are NOT logged
// because the user didn't get a result and we refund their slot.
//
// Fields:
//   sourceTitle    — the AliExpress / supplier title the user pasted
//                    (truncated to 500 chars; that's plenty even for
//                    keyword-stuffed AliExpress noise)
//   generatedTitle — the Etsy title Sonnet produced, NULL on BLOCKED
//   verdict        — "ALLOWED" | "REVIEW" | "BLOCKED"
//   category       — the Etsy category path Autopilot picked, NULL on
//                    BLOCKED (no research is done past compliance)
// Per-tag-swap audit log. Each row = one Haiku replacement-suggestion
// request (3 alternative tags generated). User may pick one or none —
// either way the suggestion call already cost ~$0.0014 in Haiku tokens
// and we log it here so the CEO dashboard's "total Anthropic spend"
// includes swap costs, not just main generation costs.
model SeoAutopilotTagSwapLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("SeoAutopilotTagSwapUser", fields: [userId], references: [id], onDelete: Cascade)
  currentTag    String   @db.VarChar(50)
  suggestedTags String[] // 0-3 entries, the tags Haiku proposed
  reason        String?  @db.VarChar(160)

  // Actual Anthropic cost — same accumulator pattern as the main gen
  actualCostUsd Float? @db.Real
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SeoAutopilotLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("SeoAutopilotLogUser", fields: [userId], references: [id], onDelete: Cascade)
  sourceTitle    String   @db.VarChar(500)
  generatedTitle String?  @db.VarChar(160)
  verdict        String   @db.VarChar(20)
  category       String?  @db.VarChar(200)

  // Actual Anthropic cost — captured from msg.usage on every call in
  // the pipeline (Haiku context + Haiku brainstorm + Haiku compliance
  // vision + Sonnet generation + optional Haiku category fallback).
  // Null for rows logged before this column was added — the read path
  // falls back to a verdict-based estimate for those.
  actualCostUsd Float? @db.Real

  // Token usage for transparency / debugging. Sum across every API
  // call made for this generation. Null on historical rows.
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?

  // Full generated listing payload — so users can revisit their own
  // past generations without burning a fresh quota slot. Shape:
  //   { title, description, tags: string[], altTexts: string[],
  //     rationale: { keywordFocus, titleStrategy, audienceHook },
  //     categoryPath, categoryId, searchKeyword, productType,
  //     audienceHint, styleHint }
  // Null when BLOCKED (no listing was generated) or on historical
  // rows logged before this column existed.
  listingJson Json?

  // User-supplied variations preserved for restore. Arrays of strings,
  // empty arrays if none given. Stored separately from listingJson so
  // they're easy to query without parsing JSON.
  sizes    String[] @default([])
  variants String[] @default([])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([verdict])
}

// AliExpress OAuth access token. One row per user-platform pair —
// most installs will only ever have ONE row (Wasif's CEO connection),
// but the schema supports multiple just in case partners want their
// own auth later.
//
// Tokens expire (AliExpress default: ~30 days for access, ~90 days
// for refresh). The refresh cron checks `expiresAt` and renews via
// the stored refreshToken before each daily auto-hunt run.
model AliExpressToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("AliExpressTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  // The access token AliExpress returns. Used as the `session` query
  // param on every /sync call. Treated as a secret — never logged.
  accessToken  String   @db.Text

  // Refresh token — exchanged for a new access token before expiry.
  refreshToken String   @db.Text

  // The seller account these tokens are bound to. Useful for the
  // "Connected as X" indicator + audit.
  aliUserId    String?  @db.VarChar(64)
  aliUserNick  String?  @db.VarChar(120)

  // Expiry timestamps. We refresh ~7 days BEFORE access expires to
  // avoid mid-request failures.
  expiresAt        DateTime
  refreshExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, aliUserId])
  @@index([expiresAt])
}

// ─── Daily Trending Products ─────────────────────────────────────────
//
// Each Etsy employee picks up to 5 niches they work (free-form strings,
// e.g. "boho jewelry", "cottagecore decor"). A daily 5 AM PKT cron
// pulls the top-selling AliExpress products per niche and stores them
// here. Employees see today's fresh batch on /daily-trending and can
// claim products to prevent intra-team racing on the same listing.
//
// Live since May 16 2026 (CEO + EM team rollout).

model EmployeeNiche {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("EmployeeNicheUser", fields: [userId], references: [id], onDelete: Cascade)
  // Free-form niche string the cron uses as an AE search query.
  // Lower-cased on insert so duplicates collapse case-insensitively.
  niche     String   @db.VarChar(80)
  // active=false = soft-disabled. Cron skips inactive rows. Lets
  // employees pause a niche without losing the row + its history.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (user, niche) — duplicate adds are 409.
  @@unique([userId, niche])
  // Cron walks all active niches once per run.
  @@index([active, niche])
  @@index([userId])
}

model DailyTrendingProduct {
  id          String   @id @default(cuid())
  // The niche this product was discovered for. Matches EmployeeNiche.niche
  // (lower-cased). Not a FK — niches can be deleted without losing history.
  niche       String   @db.VarChar(80)
  aeProductId String   @db.VarChar(40)
  title       String   @db.VarChar(300)
  imageUrl    String?  @db.VarChar(500)
  // Cost in USD as returned by AE search (target_sale_price).
  priceUsd    Float
  // Last-30-day order count from AE. Used to sort within a niche.
  ordersCount Int?
  // Direct AE product URL — opened in a new tab when employee clicks.
  productUrl  String   @db.VarChar(500)

  // Pre-computed Etsy prices using the standard markup formula
  // (no per-user personalization — that's applied client-side when
  // the employee clicks "Calc" and opens the calculator).
  suggestedEtsyMatured Float
  suggestedEtsyNew     Float

  // Date-only bucket for "today's batch". The page filters by
  // fetchDate = today (PKT). One row per (niche, aeProductId, fetchDate)
  // so re-running the cron on the same day upserts cleanly.
  fetchDate DateTime @db.Date
  fetchedAt DateTime @default(now())

  // Claim system — when an employee clicks "Claim", their id + name
  // get stamped here. Others see a "✓ Claimed by [name]" badge.
  // Reversible (DELETE clears these fields).
  claimedById   String?
  claimedBy     User?     @relation("TrendingClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  // Denormalized so the page doesn't need to join + fetch the User
  // row just to render the claim badge.
  claimedByName String?   @db.VarChar(120)
  claimedAt     DateTime?

  // One product per niche per day (upserts on re-run).
  @@unique([niche, aeProductId, fetchDate])
  // Page query: today + filter by IN (user's niches).
  @@index([fetchDate, niche])
  // Claim history per user (CEO admin view).
  @@index([claimedById])
}

